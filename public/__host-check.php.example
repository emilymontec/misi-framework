<?php

declare(strict_types=1);

/**
 * Diagnóstico de hosting — SOLO para depurar despliegues sin SSH
 * (InfinityFree y similares).
 *
 * Por qué existe: en hosting sin SSH no hay forma de correr `php -i`,
 * revisar permisos de carpetas ni ver qué archivos quedaron subidos de
 * verdad (los dotfiles suelen omitirse). Este script responde esas
 * preguntas por HTTP en una sola pantalla, SIN tocar la base de datos
 * ni exponer secretos: reporta versiones, extensiones, presencia de
 * archivos clave y permisos de escritura — nunca el CONTENIDO de .env
 * ni de ningún otro archivo.
 *
 * CÓMO USARLO:
 *   1. Requiere DEPLOY_TOKEN en tu .env (el mismo del deploy-runner).
 *   2. Renómbralo (quita ".example") a un nombre que solo tú conozcas
 *      y déjalo dentro de public/, junto a index.php.
 *   3. Visita: https://tu-dominio/tu-nombre-elegido.php?token=TU_TOKEN
 *   4. BÓRRALO del hosting cuando termines de depurar. No debe quedar
 *      accesible de forma permanente en producción.
 */

$basePath = dirname(__DIR__); // htdocs/ — igual que public/index.php asume

require $basePath . '/bootstrap/autoload.php';

use Misi\Support\Env;

header('Content-Type: text/plain; charset=utf-8');

Env::load($basePath . '/.env');
$expectedToken = (string) Env::get('DEPLOY_TOKEN', '');
$providedToken = (string) ($_GET['token'] ?? '');

$deny = static function (): never {
    http_response_code(404);
    echo "Not found.\n";
    exit;
};

if ($expectedToken === '' || $providedToken === '' || !hash_equals($expectedToken, $providedToken)) {
    $deny();
}

$line = static function (string $label, string $value): void {
    printf("%-38s %s\n", $label, $value);
};

echo "== Misi host-check ==\n\n";

$line('PHP version', PHP_VERSION . (version_compare(PHP_VERSION, '8.1.0', '>=')
    ? '  [OK]'
    : '  [FALLO: Misi requiere >= 8.1]'));
$line('SAPI', PHP_SAPI);
$line('DOCUMENT_ROOT', $_SERVER['DOCUMENT_ROOT'] ?? '(no disponible)');
$line('Script path', __DIR__);
$line('display_errors', ini_get('display_errors') ?: '(off)');

echo "\n-- Extensiones --\n";
foreach (['mbstring', 'pdo', 'pdo_mysql', 'fileinfo', 'json'] as $ext) {
    $line($ext, extension_loaded($ext) ? '[OK]' : '[FALLO: actívala en el panel]');
}
$line('putenv()', function_exists('putenv')
    ? 'disponible'
    : 'deshabilitada por el hosting [OK: Misi funciona sin ella]');

echo "\n-- Archivos y estructura --\n";
$checks = [
    '.env presente' => [$basePath . '/.env', true],
    '.htaccess raíz presente' => [$basePath . '/.htaccess', true],
    '.htaccess contiene rewrite a public/' => [$basePath . '/.htaccess', false, 'public/index.php'],
    'bootstrap/app.php presente' => [$basePath . '/bootstrap/app.php', true],
    'framework/Core/Application.php presente' => [$basePath . '/framework/Core/Application.php', true],
    'routes/web.php presente' => [$basePath . '/routes/web.php', true],
    'public/index.php presente' => [__DIR__ . '/index.php', true],
];
foreach ($checks as $label => [$path, $existsOnly, $needle = null]) {
    if ($existsOnly) {
        $line($label, is_file($path) ? '[OK]' : '[FALTA]');
        continue;
    }
    $content = is_file($path) ? (string) file_get_contents($path) : '';
    $line($label, $content !== '' && str_contains($content, (string) $needle)
        ? '[OK]'
        : "[REVISAR: falta '{$needle}' en el .htaccess subido]");
}

echo "\n-- Permisos de escritura --\n";
foreach (['storage/logs', 'storage/cache', 'storage/uploads'] as $rel) {
    $dir = $basePath . '/' . $rel;
    if (!is_dir($dir)) {
        @mkdir($dir, 0755, true);
    }
    $line($rel, is_dir($dir) && is_writable($dir) ? '[OK]' : '[FALLO: créala y da permisos 755]');
}

echo "\nFin. BORRA este archivo del hosting cuando termines.\n";
