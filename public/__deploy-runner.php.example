<?php

declare(strict_types=1);

/**
 * Ejecutor de migraciones/seeds vía navegador — SOLO para hosting sin
 * SSH (InfinityFree y similares).
 *
 * Por qué existe este archivo:
 *   InfinityFree (free tier) no da acceso SSH ni acceso remoto a MySQL
 *   desde fuera de su red (confirmado: "You cannot connect to a free
 *   hosting MySQL database from outside your hosting account" — foro
 *   oficial de InfinityFree). Eso significa que `php bin/biz migrate`
 *   NUNCA puede ejecutarse desde tu máquina local contra la base de
 *   datos de producción: el único PHP que puede hablar con esa base de
 *   datos es el que corre DENTRO de la cuenta de hosting. Sin SSH, la
 *   única forma de ejecutar ese PHP es a través de una petición HTTP.
 *   Este archivo es exactamente eso: bin/biz, pero disparado por HTTP
 *   en vez de por CLI, reutilizando las mismas clases (Migrator,
 *   Seeder) ya probadas en la Fase 4 y la Fase 10.
 *
 * CÓMO USARLO (ver deploy/infinityfree/README.md para el detalle):
 *   1. Define DEPLOY_TOKEN en tu .env de producción (valor aleatorio
 *      largo, generado con bin/biz o cualquier generador de contraseñas
 *      — NUNCA un valor corto ni predecible).
 *   2. Renombra este archivo (quita el ".example") a un NOMBRE QUE TÚ
 *      ELIJAS (no "__deploy-runner.php" — un nombre que solo tú
 *      conozcas añade una capa extra de seguridad por oscuridad, aunque
 *      la protección real es el token) y déjalo dentro de public/,
 *      junto a index.php.
 *   3. Visita:
 *      https://tu-dominio/tu-nombre-elegido.php?token=TU_TOKEN&action=status
 *      Acciones disponibles: status | migrate | rollback | seed
 *   4. Cuando termines: BORRA este archivo de htdocs/ (o al menos borra
 *      DEPLOY_TOKEN del .env). No debe quedar accesible de forma
 *      permanente en producción.
 *
 * Seguridad:
 *   - Sin DEPLOY_TOKEN configurado, este script se niega a hacer nada.
 *   - El token se compara con hash_equals() (tiempo constante).
 *   - Nunca revela si el token es "casi correcto": token inválido y
 *     archivo inexistente responden igual (404 genérico).
 *   - Cada ejecución queda registrada en storage/logs/ vía el Logger
 *     normal de Misi (nivel info), incluyendo IP y acción.
 */

// Este archivo vive dentro de public/ (junto a index.php) en
// producción. El resto del framework (bootstrap/, framework/,
// business/, config/...) vive un nivel arriba de public/ — dentro de
// htdocs/, pero fuera de la carpeta pública — exactamente igual que
// public/index.php ya asume en el repo. Ver deploy/infinityfree/README.md.
$basePath = dirname(__DIR__);

require $basePath . '/bootstrap/autoload.php';

use Misi\Core\Application;
use Misi\Database\Migrator;
use Misi\Database\Seeder;
use Misi\Support\Env;

header('Content-Type: text/plain; charset=utf-8');

Env::load($basePath . '/.env');
$expectedToken = (string) Env::get('DEPLOY_TOKEN', '');

$providedToken = (string) ($_GET['token'] ?? '');
$action = (string) ($_GET['action'] ?? 'status');

$deny = static function (): never {
    // 404 genérico: no confirma ni que el archivo existe ni que el
    // token es incorrecto. Evita darle información a quien va probando.
    http_response_code(404);
    echo "Not found.\n";
    exit;
};

if ($expectedToken === '' || $providedToken === '' || !hash_equals($expectedToken, $providedToken)) {
    $deny();
}

$allowedActions = ['status', 'migrate', 'rollback', 'seed'];

if (!in_array($action, $allowedActions, true)) {
    http_response_code(400);
    echo "Acción no reconocida. Usa una de: " . implode(', ', $allowedActions) . "\n";
    exit;
}

try {
    $app = new Application($basePath);

    $app->logger()->info('deploy-tool: ejecutando acción vía web-runner', [
        'action' => $action,
        'ip' => $_SERVER['REMOTE_ADDR'] ?? 'desconocida',
    ]);

    $sources = [
        ['label' => null, 'path' => $basePath . '/database/migrations'],
    ];

    if (is_dir($basePath . '/business/migrations')) {
        $sources[] = ['label' => 'Business', 'path' => $basePath . '/business/migrations'];
    }

    foreach ($app->modules() as $module) {
        if ($module['migrations'] !== null) {
            $sources[] = ['label' => $module['name'], 'path' => $module['migrations']];
        }
    }

    $migrator = new Migrator($app->database(), $sources);

    match ($action) {
        'status' => printStatus($migrator),
        'migrate' => printMigrate($migrator),
        'rollback' => printRollback($migrator),
        'seed' => printSeed($app),
    };
} catch (\Throwable $e) {
    // Este script solo lo alcanza quien ya tiene el token correcto, así
    // que mostrar el mensaje real (sin trace completo) es aceptable y
    // útil para depurar un despliegue en caliente.
    http_response_code(500);
    echo "Error: " . $e->getMessage() . "\n";
}

function printStatus(Migrator $migrator): void
{
    $status = $migrator->status();

    if ($status === []) {
        echo "No hay archivos de migración en database/migrations/ ni en módulos.\n";
        return;
    }

    foreach ($status as $row) {
        $batch = $row['batch'] !== null ? " (batch {$row['batch']})" : '';
        printf("%-10s %s%s\n", $row['status'], $row['migration'], $batch);
    }
}

function printMigrate(Migrator $migrator): void
{
    $executed = $migrator->run();

    if ($executed === []) {
        echo "Nada que migrar. Todo está al día.\n";
        return;
    }

    foreach ($executed as $identifier) {
        echo "Migrado: {$identifier}\n";
    }
}

function printRollback(Migrator $migrator): void
{
    $reverted = $migrator->rollback();

    if ($reverted === []) {
        echo "No hay migraciones para revertir.\n";
        return;
    }

    foreach ($reverted as $identifier) {
        echo "Revertido: {$identifier}\n";
    }
}

function printSeed(Application $app): void
{
    $seederFile = $app->basePath . '/database/seeders/DatabaseSeeder.php';

    if (!is_file($seederFile)) {
        echo "No se encontró {$seederFile}\n";
        return;
    }

    /** @var Seeder $seeder */
    $seeder = require $seederFile;
    $seeder->setDatabase($app->database());

    echo "Ejecutando DatabaseSeeder...\n";
    $seeder->run();
    echo "Seed completado.\n";
}
