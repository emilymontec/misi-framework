APP_NAME=Misi
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Bogota

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=misi
DB_USERNAME=root
DB_PASSWORD=

STORAGE_DRIVER=local
STORAGE_PATH=storage/uploads

SESSION_COOKIE=misi_session
SESSION_LIFETIME=0
SESSION_SAME_SITE=Lax

LOG_LEVEL=debug

# Solo necesario en producción, y solo mientras el deploy-runner
# esté subido al hosting (hosting sin SSH: ver DEPLOYMENT.md).
# Generar con: php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
DEPLOY_TOKEN=
