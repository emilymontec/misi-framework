{
    "name": "misi/framework",
    "description": "Misi - Base modular en PHP para sistemas administrativos de pequenos negocios",
    "type": "project",
    "version": "1.2.0",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "ext-mbstring": "*"
    },
    "autoload": {
        "psr-4": {
            "Misi\\Business\\": "business/",
            "Misi\\": "framework/",
            "App\\": "app/",
            "Modules\\": "modules/"
        }
    },
    "config": {
        "optimize-autoloader": true
    }
}
