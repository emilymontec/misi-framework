<?php

declare(strict_types=1);

namespace App\Repositories;

/**
 * {{class}}: acceso a datos de la tabla `{{table}}` vía Database
 * (Fase 4). Sin ORM — SQL explícito con prepared statements, siempre.
 * Ajusta el nombre de la tabla y las columnas si `{{table}}` no coincide
 * con tu migración.
 */
final class {{class}}
{
    private string $table = '{{table}}';

    /** @return array<int, array<string, mixed>> */
    public function all(): array
    {
        return app()->database()->select("SELECT * FROM {$this->table}");
    }

    /** @return array<string, mixed>|null */
    public function find(int $id): ?array
    {
        return app()->database()->selectOne("SELECT * FROM {$this->table} WHERE id = ?", [$id]);
    }

    /** @param array<string, mixed> $data */
    public function create(array $data): string
    {
        return app()->database()->insert($this->table, $data);
    }

    /** @param array<string, mixed> $data */
    public function update(int $id, array $data): int
    {
        return app()->database()->update($this->table, $data, 'id = ?', [$id]);
    }

    public function delete(int $id): int
    {
        return app()->database()->delete($this->table, 'id = ?', [$id]);
    }
}
