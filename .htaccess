# Misi — .htaccess raíz para InfinityFree (y hosting compartido similar).
#
# POR QUÉ EXISTE ESTE ARCHIVO (a diferencia de la versión anterior de
# deploy/infinityfree/htdocs.htaccess):
#
#   El diseño original de Misi asumía que `htdocs/` en el hosting SOLO
#   contendría lo que hoy es `public/` (index.php, css/, js/), y que
#   framework/, business/, config/, storage/, etc. vivirían UN NIVEL
#   ARRIBA de htdocs (fuera del webroot, inaccesibles por URL).
#
#   InfinityFree (plan gratuito) no lo permite: la cuenta está enjaulada
#   dentro de htdocs/, tanto por FTP como por el administrador de
#   archivos web — no se pueden crear carpetas hermanas a htdocs (error
#   confirmado: "Can't create directory: Read-only file system" /
#   "unable to create directory ... outside htdocs"). Foro oficial:
#   https://forum.infinityfree.com/t/unable-to-create-new-directory-in-root-folder/10174
#
#   Solución: TODO el proyecto vive dentro de htdocs/ (este archivo está
#   en la raíz de htdocs/, junto a framework/, business/, public/, etc.),
#   y este .htaccess reenvía cada petición hacia public/, para que
#   framework/, business/, config/, storage/, database/, .env, etc.
#   nunca sean servidos directamente por el navegador — el efecto es
#   idéntico al diseño original, solo que la protección la da este
#   archivo en vez de la ubicación física fuera del webroot.
#
#   El código PHP no cambió: bootstrap/app.php sigue calculando la raíz
#   del proyecto como dirname(__DIR__) desde public/index.php, que sigue
#   siendo exactamente un nivel arriba de public/ — solo cambió qué hay
#   "por fuera" de ese nivel (nada, en vez de la cuenta de hosting).

# Apache redirige automáticamente una petición que coincide con un
# DIRECTORIO real (ej. /routes, por el propio routes/web.php de Misi)
# hacia esa misma ruta con "/" al final, ANTES de que las reglas de
# mod_rewrite de abajo tengan oportunidad de actuar (confirmado con
# curl -v: devolvía 301 a /routes/, incluso con la regla de vistas de
# más abajo ya en su lugar). Como abajo ya decidimos explícitamente
# qué se sirve para cada ruta, este comportamiento automático de
# mod_dir sobra y rompe /routes.
<IfModule mod_dir.c>
    DirectorySlash Off
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Fuerza HTTPS (una sola vez, aquí; sesiones de Misi usan cookies Secure)
    RewriteCond %{HTTPS} off
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Excepción puntual: solo la ruta exacta "/" y solo si existe un
    # index.html real en la raíz, se sirve tal cual (sin pasar por
    # PHP) — es la landing de marketing (ver index.html), distinta de
    # resources/views/welcome.php (la bienvenida de desarrollo local,
    # que sigue sirviéndose por el router en cualquier otra ruta).
    # A propósito NO es una regla genérica de "si el archivo existe en
    # la raíz, sírvelo": eso expondría framework/*.php, config/*.php,
    # etc. como archivos planos. Todo lo demás sigue forzado a pasar
    # por public/.
    #
    # OJO con [L] aquí: en contexto de .htaccess (por-directorio), [L]
    # NO detiene la reescritura del todo — Apache hace un internal
    # redirect a "index.html" y vuelve a evaluar este mismo .htaccess
    # desde el principio para esa nueva URI. Como "index.html" no
    # coincide con ninguna condición de las reglas de arriba, cae en la
    # regla catch-all de más abajo y termina en public/index.php de
    # todas formas (confirmado con RewriteLog). [END] sí corta la
    # reescritura por completo (Apache 2.4+, disponible en InfinityFree).
    RewriteCond %{REQUEST_URI} ^/$
    RewriteCond %{DOCUMENT_ROOT}/index.html -f
    RewriteRule ^$ index.html [END]

    # Vistas de marketing con URL limpia: /cli -> public/views/cli.html,
    # /misi -> public/views/misi.html, /ui-kit -> public/views/ui-kit.html,
    # etc. (ver bin/build-landing.php). Mismo criterio y mismo cuidado con
    # [END] que la excepción de "/" de arriba: NUNCA es un passthrough
    # genérico de "si existe en algún lado, sírvelo" — solo mira dentro de
    # public/views/, nunca fuera de ahí.
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteCond %{DOCUMENT_ROOT}/public/views%{REQUEST_URI}.html -f
    RewriteRule ^(.*)$ public/views/$1.html [END]

    # Si la petición ya apunta a /public/... (poco común, pero evita bucles
    # y evita que alguien intente acceder a /public/framework/... etc.)
    RewriteCond %{REQUEST_URI} ^/public/ [NC]
    RewriteRule ^ - [L]

    # Si existe un archivo REAL dentro de public/ (css/misi.css, js/api.js,
    # el propio index.php, o un script de despliegue puntual), servirlo
    # directamente desde ahí.
    RewriteCond %{DOCUMENT_ROOT}/public%{REQUEST_URI} -f
    RewriteRule ^(.*)$ public/$1 [L]

    # Todo lo demás (rutas de la aplicación: /customers, /api/uploads,
    # /storage/{path}, etc.) pasa por el front controller de Misi.
    RewriteRule ^ public/index.php [L]
</IfModule>

# Defensa en profundidad: si mod_rewrite no estuviera disponible por
# algún motivo, bloquear todo acceso directo a este nivel en vez de
# arriesgarse a exponer framework/, business/, config/ o .env.
<IfModule !mod_rewrite.c>
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</IfModule>

# Bloquea dotfiles (.env, .git si llegara a subirse por error, este mismo
# .htaccess) incluso si alguien pidiera la ruta exacta.
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
